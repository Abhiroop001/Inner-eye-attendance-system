# ==============================================================================
# Security-First Employee Attendance System - Environment Configuration
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
WEB_URL=http://localhost:5173
API_URL=http://localhost:5000/api

# Database (MongoDB with Atlas Search / Vector Search or Local Replica Set)
MONGODB_URI=mongodb://127.0.0.1:27017/attendance_db?directConnection=true
MONGODB_DB_NAME=attendance_db

# Cache & Distributed Rate Limiting (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Groq LLM API (High-performance low-latency structured output)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_demo_placeholder_or_real_key
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Inference API (Embeddings & Feature Extraction)
# Obtain from https://huggingface.co/settings/tokens
HF_TOKEN=hf_demo_placeholder_or_real_key
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security & Cryptographic Secrets (Minimum 32 random characters for production)
SESSION_SECRET=enterprise_session_secret_replace_in_prod_min_32_chars_long!
JWT_ACCESS_SECRET=enterprise_jwt_access_secret_replace_in_prod_min_32_chars!
JWT_REFRESH_SECRET=enterprise_jwt_refresh_secret_replace_in_prod_min_32_chars!
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MFA Configuration
MFA_ISSUER=EnterpriseHR_Security

# Storage & Malware Scanning Configuration (Private GridFS)
STORAGE_PROVIDER=gridfs
MALWARE_SCAN_ENABLED=true
MAX_UPLOAD_SIZE_MB=10

# Logging & Telemetry
LOG_LEVEL=info

# Development-Only Helpers (Strictly disabled in production)
DEV_SHOW_ACTIVATION_LINKS=true
